# ============================================================
# 记账 App — Git 忽略规则
# 原则：只提交"人手写的东西"，不提交工具链、构建产物、密钥与测试证据。
# ============================================================

# ---- 构建工具链（约 9.4 GB，绝对不能提交）----
# JDK + Android SDK + 模拟器 + 系统镜像 + AVD 数据都在这里。
# 它由 tools/README 里的步骤重新下载即可，不属于源码。
.android-env/

# ---- 签名密钥（绝对不能提交）----
# 这是 App 的"身份"。丢失后无法再为已安装的 App 发布更新；
# 泄露则别人可以伪造同包名的升级包。请单独离线备份。
keys/*
# 但保留目录说明，让人知道这里本该有什么、以及为什么它不在仓库里
!keys/README.md

# ---- 构建产物 ----
# build/ 每次构建都会被 build.cmd 整个删除重建，属于可再生产物。
build/
*.apk
*.aab
*.ap_
*.dex
*.class

# ---- 测试与验证证据（截图与探针输出，约 15 MB）----
verify2-out/

# ---- 团队协作插件的运行状态 ----
.agent-teams/

# ---- 编辑器与系统 ----
.vscode/
.idea/
*.iml
*.swp
*~
Thumbs.db
Desktop.ini
.DS_Store

# ---- 临时文件与日志 ----
*.log
*.tmp
bl.txt
_writetest*
.dsh-*.tmp
*.orig
*.rej
